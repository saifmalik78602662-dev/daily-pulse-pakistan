# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

# Port the server listens on
PORT=3000

# Password for the /admin dashboard login
ADMIN_PASSWORD=change-this-password

# Contact form messages will be emailed to this address
CONTACT_EMAIL=saifmalik78602662@gmail.com

# --- SMTP settings used to actually SEND the contact-form email ---
# If you use Gmail: you CANNOT use your normal Gmail password here.
# 1. Turn on 2-Step Verification on the Google account:
#    https://myaccount.google.com/security
# 2. Create an "App Password":
#    https://myaccount.google.com/apppasswords
# 3. Put that 16-character app password below (not your real Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=saifmalik78602662@gmail.com
SMTP_PASS=your-16-character-app-password

# A random long string used to sign admin session tokens
SESSION_SECRET=please-change-this-to-a-long-random-string
